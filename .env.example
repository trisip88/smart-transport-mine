# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# LTA_ACCOUNT_KEY: Singapore Land Transport Authority (LTA) DataMall Account Key.
# Required for live Datamall v3 BusArrival, CarParkAvailabilityv2, TrafficIncidents, and TrainServiceAlerts.
LTA_ACCOUNT_KEY=""

# TRANSIT_API_KEY: Alias for LTA DataMall or external transit provider API Key.
TRANSIT_API_KEY=""

# TRANSIT_API_ENDPOINT: Optional custom transit API endpoint base URL.
TRANSIT_API_ENDPOINT=""

# MAPS_API_KEY: Optional Google Maps or external Geocoding/Routing API Key.
MAPS_API_KEY=""

# ONEMAP_EMAIL: OneMap Singapore (SLA) registered account email.
ONEMAP_EMAIL=""

# ONEMAP_PASSWORD: OneMap Singapore (SLA) account password (used to mint 3-day access tokens).
ONEMAP_PASSWORD=""

# ONEMAP_API_TOKEN: Optional pre-minted OneMap Singapore access token.
ONEMAP_API_TOKEN=""
